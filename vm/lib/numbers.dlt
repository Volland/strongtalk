sin ^<Float>
	^{{self primitiveFloatSineIfFail: [:err <Symbol> | 0.0]}}
!

cos ^<Float>
	^{{self primitiveFloatCosineIfFail: [:err <Symbol> | 0.0]}}
!

tan ^<Float>
	^{{self primitiveFloatTangentIfFail: [:err <Symbol> | 0.0]}}
!

