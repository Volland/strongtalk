>= other <Number> ^<Boolean>
	^{{self primitiveFloatGreaterThanOrEqual: other ifFail: [:err <Symbol> | self retry: #>= coercing: other]}}
!

= other <Object> ^<Boolean>
	^{{self primitiveFloatEqual: other ifFail: [:err <Symbol> | self retry: #= coercing: other]}}
!

~= other <Object> ^<Boolean>
	^{{self primitiveFloatNotEqual: other ifFail: [:err <Symbol> | self retry: #~= coercing: other]}}
!

hash ^<Int>
	self fractionPart = 0.0 ifTrue: [^self truncated hash].
	^{{self primitiveHash}}
! !

! (Delta mirrorFor: #Float) methodsFor: 'mathematical functions' !

sqrt ^<Float>
	^{{self primitiveFloatSqrtIfFail: [:err <Symbol> | 0.0]}}
