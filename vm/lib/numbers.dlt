! (Delta mirrorFor: #Float) methodsFor: 'converting' !

asFloat ^<Float>
	^self
!

truncated ^<Int>
	"As the VM does it: cut toward zero as a Float (0x4cc2b0), then convert to a SmallInteger
	(0x4cc5a0); results too big for a SmallInteger become LargeIntegers."
	| t <Float> |
	t := {{self primitiveFloatTruncated}}.
	^{{t primitiveFloatAsSmallIntegerIfFail: [:err <Symbol> |
		{{self primitiveFloatTruncatedIfFail: [:err2 <Symbol> | self error: 'cannot truncate ', self printString]}}]}}
!

floor ^<Int>
	"primitiveFloatSmallIntegerFloorIfFail: (0x4cbfb0), with a LargeInteger fallback."
	^{{self primitiveFloatSmallIntegerFloorIfFail: [:err <Symbol> |
		{{self primitiveFloatFloorIfFail: [:err2 <Symbol> | self error: 'cannot take the floor of ', self printString]}}]}}
!

ceiling ^<Int>
	^{{self primitiveFloatCeilingIfFail: [:err <Symbol> | self error: 'cannot take the ceiling of ', self printString]}}
!

rounded ^<Int>
	"The VM rounds to a SmallInteger (0x4cc480); too-large results are rounded with LargeIntegers."
	^{{self primitiveFloatRoundedAsSmallIntegerIfFail: [:err <Symbol> |
		{{self primitiveFloatRoundedIfFail: [:err2 <Symbol> | self error: 'cannot round ', self printString]}}]}}
!

fractionPart ^<Float>
	^{{self primitiveFloatFractionPartIfFail: [:err <Symbol> | 0.0]}}
!

integerPart ^<Float>
	^self - self fractionPart
!

generality ^<Int>
	^40
!

coerce: n <Number> ^<Float>
	^n asFloat
! !

! (Delta mirrorFor: #Float) methodsFor: 'testing' !

isFloat ^<Boolean>
	^true
!

isNaN ^<Boolean>
	^{{self primitiveFloatIsNaNIfFail: [:err <Symbol> | false]}}
!

isInfinite ^<Boolean>
	^self = Float infinity or: [self = Float infinity negated]
! !

! (Delta mirrorFor: #Float) methodsFor: 'printing' !

printOn: aStream <WriteStream>
	aStream nextPutAll: {{self primitiveFloatPrintStringIfFail: [:err <Symbol> | 'a Float']}}
!

printString: digits <Int> ^<String>
	"The receiver with a fixed number of digits after the point."
	^{{self primitiveFloatPrintString: digits ifFail: [:err <Symbol> | self printString]}}
!

roundTo: quantum <Number> ^<Float>
	^(self / quantum) rounded * quantum asFloat
! !

! (Delta mirrorFor: #Float) methodsFor: 'copying' !

shallowCopy ^<Self>
	^self
!

deepCopy ^<Self>
	^self
! !

Delta define: #Fraction as: (
(Class subclassOf: 'Number' instanceVariables: 'numerator <Int> denominator <Int>')) !
(Delta mirrorFor: #Fraction) group: 'numbers' !
(Delta mirrorFor: #Fraction) comment: 'Exact rational numbers such as 1/3, always kept in lowest terms with a positive denominator.' !

! (Delta mirrorFor: #Fraction) classSide methodsFor: 'instance creation' !

numerator: n <Int> denominator: d <Int> ^<Instance>
	^self new setNumerator: n denominator: d
! !

! (Delta mirrorFor: #Fraction) methodsFor: 'private' !

setNumerator: n <Int> denominator: d <Int> ^<Self>
	d = 0 ifTrue: [^ZeroDivide new dividend: n; signal: 'division by zero'].
	d < 0
		ifTrue: [numerator := n negated. denominator := d negated]
		ifFalse: [numerator := n. denominator := d]
!

reduced ^<Number>
	| g <Int> n <Int> d <Int> |
	numerator = 0 ifTrue: [^0].
	g := numerator gcd: denominator.
	n := numerator // g.
	d := denominator // g.
	d = 1 ifTrue: [^n].
	^Fraction numerator: n denominator: d
! !

! (Delta mirrorFor: #Fraction) methodsFor: 'accessing' !

numerator ^<Int>
	^numerator
!

denominator ^<Int>
	^denominator
! !

! (Delta mirrorFor: #Fraction) methodsFor: 'arithmetic' !

+ other <Number> ^<Number>
	(other isInteger or: [other isFraction]) ifFalse: [^self retry: #+ coercing: other].
	^(Fraction
		numerator: numerator * other denominator + (other numerator * denominator)
		denominator: denominator * other denominator) reduced
!

- other <Number> ^<Number>
	(other isInteger or: [other isFraction]) ifFalse: [^self retry: #- coercing: other].
	^(Fraction
		numerator: numerator * other denominator - (other numerator * denominator)
		denominator: denominator * other denominator) reduced
!

* other <Number> ^<Number>
	(other isInteger or: [other isFraction]) ifFalse: [^self retry: #* coercing: other].
	^(Fraction
		numerator: numerator * other numerator
		denominator: denominator * other denominator) reduced
!

/ other <Number> ^<Number>
	(other isInteger or: [other isFraction]) ifFalse: [^self retry: #/ coercing: other].
	other = 0 ifTrue: [^ZeroDivide new dividend: self; signal: 'division by zero'].
	^(Fraction
		numerator: numerator * other denominator
		denominator: denominator * other numerator) reduced
!

// other <Number> ^<Int>
	^(self / other) floor
!

\\ other <Number> ^<Number>
	^self - ((self // other) * other)
!

negated ^<Number>
	^Fraction numerator: numerator negated denominator: denominator
!

reciprocal ^<Number>
	^(Fraction numerator: denominator denominator: numerator) reduced
! !

! (Delta mirrorFor: #Fraction) methodsFor: 'comparing' !

< other <Number> ^<Boolean>
	(other isInteger or: [other isFraction]) ifFalse: [^self retry: #< coercing: other].
	^numerator * other denominator < (other numerator * denominator)
!

= other <Object> ^<Boolean>
	other isNumber ifFalse: [^false].
	other isFloat ifTrue: [^self asFloat = other].
	^numerator = other numerator and: [denominator = other denominator]
!

hash ^<Int>
	^numerator hash bitXor: denominator hash
! !

! (Delta mirrorFor: #Fraction) methodsFor: 'converting' !

asFloat ^<Float>
	^numerator asFloat / denominator asFloat
!

truncated ^<Int>
	^numerator quo: denominator
!

floor ^<Int>
	^numerator // denominator
!

ceiling ^<Int>
	^(numerator + denominator - 1) // denominator
!

rounded ^<Int>
	^(self + (1/2)) floor
!

generality ^<Int>
	^30
!

coerce: n <Number> ^<Number>
	^Fraction numerator: n truncated denominator: 1
! !

! (Delta mirrorFor: #Fraction) methodsFor: 'testing' !

isFraction ^<Boolean>
	^true
! !

! (Delta mirrorFor: #Fraction) methodsFor: 'printing' !

printOn: aStream <WriteStream>
	aStream print: numerator; nextPut: $/; print: denominator
! !

Delta define: #Character as: (
(Class subclassOf: 'Magnitude' instanceVariables: '')) !
(Delta mirrorFor: #Character) group: 'text' !
(Delta mirrorFor: #Character) comment: 'Characters ($a, $Z, $ ). Like SmallIntegers they are values.' !

! (Delta mirrorFor: #Character) classSide methodsFor: 'instance creation' !

value: code <Int> ^<Character>
	^{{primitiveCharacterFor: code ifFail: [:err <Symbol> | self error: code printString, ' is not a character code']}}
!

cr ^<Character>
	^self value: 13
!

lf ^<Character>
	^self value: 10
!

nl ^<Character>
	^self value: 10
!

tab ^<Character>
	^self value: 9
!

space ^<Character>
	^self value: 32
!

esc ^<Character>
	^self value: 27
! !

! (Delta mirrorFor: #Character) methodsFor: 'accessing' !

value ^<Int>
	^{{self primitiveCharacterValueIfFail: [:err <Symbol> | 0]}}
!

asInteger ^<Int>
	^self value
!

asCharacter ^<Character>
	^self
!

digitValue ^<Int>
	self isDigit ifTrue: [^self value - 48].
	self isLetter ifTrue: [^self asUppercase value - 55].
	^-1
! !

! (Delta mirrorFor: #Character) methodsFor: 'comparing' !

< other <Character> ^<Boolean>
	^self value < other value
!

hash ^<Int>
	^self value
! !

! (Delta mirrorFor: #Character) methodsFor: 'testing' !

isCharacter ^<Boolean>
	^true
!

isVowel ^<Boolean>
	^{{self primitiveCharacterTest: #vowel ifFail: [:err <Symbol> | false]}}
!

isLetter ^<Boolean>
	^{{self primitiveCharacterTest: #letter ifFail: [:err <Symbol> | false]}}
!

isDigit ^<Boolean>
	^{{self primitiveCharacterTest: #digit ifFail: [:err <Symbol> | false]}}
!

isUppercase ^<Boolean>
	^{{self primitiveCharacterTest: #upper ifFail: [:err <Symbol> | false]}}
!

isLowercase ^<Boolean>
	^{{self primitiveCharacterTest: #lower ifFail: [:err <Symbol> | false]}}
!

isSeparator ^<Boolean>
	^{{self primitiveCharacterTest: #separator ifFail: [:err <Symbol> | false]}}
!

isAlphaNumeric ^<Boolean>
	^{{self primitiveCharacterTest: #alphanumeric ifFail: [:err <Symbol> | false]}}
! !

! (Delta mirrorFor: #Character) methodsFor: 'converting' !

asUppercase ^<Character>
	^{{self primitiveCharacterTest: #asUppercase ifFail: [:err <Symbol> | self]}}
!

asLowercase ^<Character>
	^{{self primitiveCharacterTest: #asLowercase ifFail: [:err <Symbol> | self]}}
!

asString ^<String>
	^{{self primitiveCharacterTest: #asString ifFail: [:err <Symbol> | '?']}}
!

asSymbol ^<Symbol>
	^self asString asSymbol
!

to: other <Character> ^<Array>
	^(self value to: other value) collect: [:i <Int> | Character value: i]
! !

! (Delta mirrorFor: #Character) methodsFor: 'printing' !

printOn: aStream <WriteStream>
	aStream nextPut: $$; nextPut: self
!

displayString ^<String>
	^self asString
! !

! (Delta mirrorFor: #Character) methodsFor: 'copying' !

shallowCopy ^<Self>
	^self
!

deepCopy ^<Self>
	^self
! !
